# Copiare questo file in .env e riempirlo: cp .env.example .env
# .env e' gitignored, non va versionato.

# --- chat (opzionale) ---
# senza questa variabile POST /ingest funziona comunque, GET /chat no (401)
#OPENAI_CHAT_API_KEY=

# --- embedding (obbligatorio per POST /ingest) ---
# chiave Jina AI: https://jina.ai/api-dashboard/key-manager
JINA_API_KEY=

# --- override opzionali (gia' hanno dei default in application.yml) ---
#OPENAI_CHAT_BASE_URL=https://api.openai.com
#OPENAI_CHAT_MODEL=gpt-4o-mini
#JINA_BASE_URL=https://api.jina.ai
#JINA_EMBEDDING_MODEL=jina-embeddings-v5-omni-small
#ELASTIC_URIS=http://localhost:9200
